{
  "id": "knowledge",
  "name": "Knowledge",
  "version": "0.1.1",
  "description": "A pack for learning things: Claude researches the web into your wiki, and a desk for reading next to it.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "school",
  "kind": "app",
  "dependencies": {
    "wiki": ">=0.1.0, <1.0.0",
    "browser": ">=0.1.0, <1.0.0",
    "claude": ">=0.3.0, <1.0.0"
  },
  "sessions": [
    {
      "id": "research",
      "name": "Research a topic",
      "icon": "travel_explore",
      "description": "Claude, with a first message ready, researches the web and writes linked wiki pages; the wiki and the web beside it.",
      "layout": {
        "v": 1,
        "root": {
          "type": "split",
          "dir": "row",
          "sizes": [
            0.4,
            0.6
          ],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "claude",
                  "panel": "threads",
                  "params": {
                    "prompt": "Research a topic for me on the web and write it into my wiki: a page for the topic, linked pages for its main ideas, and the sources on each page. Ask me first which topic, then tell me what you wrote."
                  }
                }
              ]
            },
            {
              "type": "split",
              "dir": "column",
              "sizes": [
                0.6,
                0.4
              ],
              "children": [
                {
                  "type": "tabs",
                  "tabs": [
                    {
                      "plugin": "wiki",
                      "panel": "main"
                    }
                  ]
                },
                {
                  "type": "tabs",
                  "tabs": [
                    {
                      "plugin": "browser",
                      "panel": "start"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "floating": []
      }
    },
    {
      "id": "read",
      "name": "Read and take notes",
      "icon": "book",
      "description": "A web page on the left, your wiki on the right to write down what you learn.",
      "layout": {
        "v": 1,
        "root": {
          "type": "split",
          "dir": "row",
          "sizes": [
            0.55,
            0.45
          ],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "browser",
                  "panel": "start"
                }
              ]
            },
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "wiki",
                  "panel": "main"
                }
              ]
            }
          ]
        },
        "floating": []
      }
    }
  ]
}
